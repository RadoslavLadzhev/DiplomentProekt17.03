@model IEnumerable<ASPBMWElit.Data.Inquiring>

@{
    ViewData["Title"] = "Заявки";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Заявки</h1>
            <p class="text-muted">Списък със заявките за оглед на автомобили</p>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            + Заяви автомобил
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Клиент</th>
                        <th>Автомобил</th>
                        <th>Съобщение</th>
                        <th>Дата за оглед</th>
                        <th>Създадена на</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td class="ps-4 fw-semibold">
                                @item.Client?.UserName
                            </td>

                            <td>
                                @item.CarId
                            </td>

                            <td style="max-width:300px;">
                                @item.Message
                            </td>

                            <td>
                                @item.InspectionDate.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @item.CreateAt.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                            Редактирай
                                        </a>
                                    }

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white">
                                        Детайли
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        Изтрий
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>