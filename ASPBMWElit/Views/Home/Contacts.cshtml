@{
    ViewData["Title"] = "Контакти и сервиз";
}

<section class="service-hero">
    <div class="service-overlay"></div>

    <div class="service-content">
        <h1>Сервизен партньор на BMW.</h1>
        <p>Спокойно. Ние ще се погрижим.</p>

        <a href="#contact-form" class="btn btn-primary btn-lg">
            Свържете се с нас
        </a>
    </div>
</section>

<section class="contact-section">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Контакти и сервиз</h2>
            <p class="text-muted">
                Свържете се с нас при въпроси относно автомобили, оборудване, наличности и поръчки.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-5">
                <div class="contact-card h-100">
                    <h3 class="fw-bold mb-4">Информация за връзка</h3>

                    <div class="contact-item">
                        <span>АДРЕС</span>
                        <p>гр. Карлово, ул. Ген. Карцов</p>
                    </div>

                    <div class="contact-item">
                        <span>ТЕЛЕФОН</span>
                        <p>+359 88 123 4567</p>
                    </div>

                    <div class="contact-item">
                        <span>ИМЕЙЛ</span>
                        <p>bmwelit@gmail.com</p>
                    </div>

                    <div class="contact-item">
                        <span>РАБОТНО ВРЕМЕ</span>
                        <p>Понеделник - Петък: 09:00 - 18:00</p>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="contact-card" id="contact-form">
                    <h3 class="fw-bold mb-4 text-center">Добавяне на коментар</h3>

                    <form asp-action="Contacts" asp-controller="Home" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Име*</label>
                            <input type="text" class="form-control custom-input" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Имейл*</label>
                            <input type="email" class="form-control custom-input" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Коментар*</label>
                            <textarea class="form-control custom-input" rows="6"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary px-5 py-2">
                            Изпрати
                        </button>
                    </form>
                    
                </div>
            </div>

        </div>
    </div>
</section>