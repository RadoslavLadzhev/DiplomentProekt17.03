@model ASPBMWElit.Data.Car

@{
    ViewData["Title"] = "Детайли";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img id="mainImage" src="@Model.ImageUrl"
                 style="width:100%; height:350px; object-fit:cover;" class="mb-3" />
        </div>

        <div class="col-md-6">
            <h2>@Model.Model</h2>
            <h4 class="text-success">@Model.Price лв</h4>

            <hr />

            <p><b>Каталожен номер:</b> @Model.CatalogNumber</p>
            <p><b>Тип:</b> @Model.CarType</p>
            <p><b>Конски сили:</b> @Model.HorsePower</p>
            <p><b>Ускорение:</b> @Model.Acceleration</p>
            <p><b>Вид гориво:</b> @Model.FuelTypes.Id</p>
            <p><b>Вид оборудване:</b> @Model.Equipments.Id</p>

            <hr />

            <h5>Описание</h5>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>

            <hr />

            <form asp-controller="Inquirings" asp-action="Create" method="get">
                <input type="hidden" name="carId" value="@Model.Id" />

                <button type="submit" class="btn btn-primary">
                    Запази оглед
                </button>
            </form>

            <br />

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редакция</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Изтрий</a>
            }

            <br /><br />
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </div>
</div>

<script>
    function changeImage(src) {
        document.getElementById("mainImage").src = src;
    }
</script>