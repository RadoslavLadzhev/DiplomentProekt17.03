@model ASPBMWElit.Data.Car

@{
    ViewData["Title"] = "Добави автомобил";
}

<h1 class="text-center mb-4">Добави автомобил</h1>

<form asp-action="Create" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="CatalogNumber" class="form-label"></label>
        <input asp-for="CatalogNumber" class="form-control" />
        <span asp-validation-for="CatalogNumber" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EquipmentId" class="form-label"></label>
        <select asp-for="EquipmentId" asp-items='@(ViewData["EquipmentId"] as SelectList)' class="form-select"></select>
        <span asp-validation-for="EquipmentId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FuelTypeId" class="form-label"></label>
        <select asp-for="FuelTypeId" asp-items='@(ViewData["FuelTypeId"] as SelectList)' class="form-select"></select>
        <span asp-validation-for="FuelTypeId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CarType" class="form-label"></label>
        <select asp-for="CarType" asp-items='@(ViewData["CarType"] as SelectList)' class="form-select"></select>
    </div>

    <div class="col-md-4">
        <label asp-for="HorsePower" class="form-label"></label>
        <input asp-for="HorsePower" class="form-control" />
        <span asp-validation-for="HorsePower" class="text-danger"></span>
    </div>

    <div class="col-md-2">
        <label asp-for="Acceleration" class="form-label"></label>
        <input asp-for="Acceleration" class="form-control" />
        <span asp-validation-for="Acceleration" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-success">Запази</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Назад</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}